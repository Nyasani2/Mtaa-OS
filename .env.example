# MTAA OS V10 - Production Environment Variables
# Copy this to .env and fill in your actual keys

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Map & Location Services
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# Payments (M-Pesa Daraja)
EXPO_PUBLIC_MPESA_CONSUMER_KEY=your-consumer-key
EXPO_PUBLIC_MPESA_CONSUMER_SECRET=your-consumer-secret
EXPO_PUBLIC_MPESA_SHORTCODE=174379
EXPO_PUBLIC_MPESA_PASSKEY=your-passkey

# AI & Cognitive Engine
EXPO_PUBLIC_ASIS_API_KEY=your-asis-key
