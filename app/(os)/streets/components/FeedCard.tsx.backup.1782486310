import React, { useRef, useEffect } from 'react';
import {
  View, Text, StyleSheet, TouchableOpacity, Image, Dimensions, Platform,
} from 'react-native';
import { useRouter } from 'expo-router';
import { Ionicons } from '@expo/vector-icons';
import { useAuthStore } from '@/lib/auth/store/auth.store';
import { supabase } from '@/lib/supabase';

const { width: SCREEN_W, height: SCREEN_H } = Dimensions.get('window');

interface FeedCardProps {
  post: any;
  isVisible: boolean;
}

function getPosterUrl(post: any): string | null {
  if (post.media_type === 'video') {
    return post.video_thumbnail_url || post.thumbnail_url || null;
  }
  if (post.media_type === 'image') {
    return post.media_url || post.thumbnail_url || null;
  }
  return null;
}

export default function FeedCard({ post, isVisible }: FeedCardProps) {
  const router = useRouter();
  const { user, isAuthenticated } = useAuthStore();
  const videoRef = useRef<HTMLVideoElement | null>(null);
  const creatorName = post.creator?.full_name || post.creator?.display_name || post.creator?.username || 'User';
  const isGuest = !isAuthenticated || !user;
  const isOwnPost = user?.id === post.creator_id;
  const posterUrl = getPosterUrl(post);
  const isVideo = post.media_type === 'video';
  const isText = post.media_type === 'text' || (!post.media_url && !post.content);

  // Auto-play/pause video based on visibility
  useEffect(() => {
    if (isVideo && videoRef.current) {
      if (isVisible) {
        videoRef.current.play().catch(() => {});
      } else {
        videoRef.current.pause();
        videoRef.current.currentTime = 0;
      }
    }
  }, [isVisible, isVideo]);

  const handleLike = async () => {
    if (isGuest) return;
    await supabase.from('streets_likes').insert({ post_id: post.id, user_id: user!.id });
  };

  const handleComment = () => {
    router.push(`/streets/comments?postId=${post.id}`);
  };

  const handleShare = async () => {
    if (isGuest) return;
    await supabase.from('streets_shares').insert({ post_id: post.id, user_id: user!.id });
  };

  const handleSave = async () => {
    if (isGuest) return;
    await supabase.from('streets_saves').insert({ post_id: post.id, user_id: user!.id });
  };

  const goToCreator = () => {
    router.push(`/streets/creator?userId=${post.creator_id}`);
  };

  return (
    <View style={styles.container}>
      {/* Media Layer */}
      <View style={styles.mediaLayer}>
        {isVideo && post.media_url ? (
          Platform.OS === 'web' ? (
            <video
              ref={videoRef}
              src={post.media_url}
              style={styles.video}
              muted
              loop
              playsInline
              preload="auto"
              poster={posterUrl || undefined}
            />
          ) : (
            <View style={[styles.mediaFallback, { backgroundColor: '#111' }]}>
              <Ionicons name="videocam" size={48} color="#00d4ff" />
              <Text style={styles.fallbackText}>Video</Text>
            </View>
          )
        ) : post.media_url && post.media_type === 'image' ? (
          <Image source={{ uri: post.media_url }} style={styles.media} resizeMode="cover" />
        ) : (
          <View style={[styles.mediaFallback, styles.textCard]}>
            <Text style={styles.textContent}>{post.content || post.caption || 'Text post'}</Text>
          </View>
        )}
      </View>

      {/* Dark gradient overlay for text readability */}
      <View style={styles.gradientOverlay} pointerEvents="none" />

      {/* Right Action Column */}
      <View style={styles.actionsColumn}>
        <TouchableOpacity onPress={handleLike} style={styles.actionItem}>
          <Ionicons name="heart" size={32} color="#fff" />
          <Text style={styles.actionCount}>{post.likes_count || 0}</Text>
        </TouchableOpacity>
        <TouchableOpacity onPress={handleComment} style={styles.actionItem}>
          <Ionicons name="chatbubble" size={28} color="#fff" />
          <Text style={styles.actionCount}>{post.comments_count || 0}</Text>
        </TouchableOpacity>
        <TouchableOpacity onPress={handleShare} style={styles.actionItem}>
          <Ionicons name="share-social" size={28} color="#fff" />
          <Text style={styles.actionCount}>{post.shares_count || 0}</Text>
        </TouchableOpacity>
        <TouchableOpacity onPress={handleSave} style={styles.actionItem}>
          <Ionicons name="bookmark" size={28} color="#fff" />
        </TouchableOpacity>
        {isOwnPost && (
          <TouchableOpacity onPress={() => router.push(`/streets/create?editPostId=${post.id}`)} style={styles.actionItem}>
            <Ionicons name="create" size={24} color="#00d4ff" />
          </TouchableOpacity>
        )}
      </View>

      {/* Bottom Info */}
      <View style={styles.infoLayer}>
        <TouchableOpacity style={styles.creatorRow} onPress={goToCreator}>
          {post.creator?.avatar_url ? (
            <Image source={{ uri: post.creator.avatar_url }} style={styles.avatar} />
          ) : (
            <View style={[styles.avatar, styles.avatarFallback]}>
              <Ionicons name="person" size={18} color="#fff" />
            </View>
          )}
          <View style={styles.creatorInfo}>
            <Text style={styles.creatorName}>{creatorName}</Text>
            {post.creator?.verified && (
              <Ionicons name="checkmark-circle" size={14} color="#00d4ff" style={{ marginLeft: 4 }} />
            )}
          </View>
        </TouchableOpacity>

        <Text style={styles.caption} numberOfLines={3}>
          {post.content || post.caption || ''}
        </Text>

        <View style={styles.musicRow}>
          <Ionicons name="musical-note" size={12} color="#00d4ff" />
          <Text style={styles.musicText}>Original Sound - {creatorName}</Text>
        </View>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    width: SCREEN_W,
    height: SCREEN_H,
    backgroundColor: '#000',
    position: 'relative',
  },
  mediaLayer: {
    ...StyleSheet.absoluteFillObject,
    zIndex: 1,
  },
  media: {
    width: '100%',
    height: '100%',
  },
  video: {
    width: '100%',
    height: '100%',
    objectFit: 'cover',
  },
  mediaFallback: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    padding: 32,
  },
  textCard: {
    backgroundColor: '#1a1a2e',
  },
  textContent: {
    color: '#fff',
    fontSize: 20,
    textAlign: 'center',
    lineHeight: 28,
    fontWeight: '500',
  },
  fallbackText: {
    color: '#888',
    fontSize: 14,
    marginTop: 8,
  },
  gradientOverlay: {
    ...StyleSheet.absoluteFillObject,
    zIndex: 2,
    backgroundColor: 'rgba(0,0,0,0.2)',
  },
  actionsColumn: {
    position: 'absolute',
    right: 12,
    bottom: 100,
    zIndex: 10,
    alignItems: 'center',
    gap: 16,
  },
  actionItem: {
    alignItems: 'center',
  },
  actionCount: {
    color: '#fff',
    fontSize: 12,
    marginTop: 4,
    fontWeight: '600',
  },
  infoLayer: {
    position: 'absolute',
    bottom: 0,
    left: 0,
    right: 80,
    zIndex: 10,
    padding: 16,
    paddingBottom: Platform.OS === 'ios' ? 40 : 24,
  },
  creatorRow: {
    flexDirection: 'row',
    alignItems: 'center',
    marginBottom: 8,
  },
  avatar: {
    width: 40,
    height: 40,
    borderRadius: 20,
    marginRight: 10,
    borderWidth: 2,
    borderColor: '#00d4ff',
  },
  avatarFallback: {
    backgroundColor: '#444',
    justifyContent: 'center',
    alignItems: 'center',
  },
  creatorInfo: {
    flexDirection: 'row',
    alignItems: 'center',
  },
  creatorName: {
    color: '#fff',
    fontSize: 15,
    fontWeight: '700',
  },
  caption: {
    color: '#fff',
    fontSize: 14,
    lineHeight: 20,
    marginBottom: 8,
  },
  musicRow: {
    flexDirection: 'row',
    alignItems: 'center',
  },
  musicText: {
    color: '#00d4ff',
    fontSize: 12,
    marginLeft: 6,
  },
});
