{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [{"name": "next"}]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/(admin)/**/*.ts",
    "app/(admin)/**/*.tsx",
    "app/(os)/index.tsx",
    "app/(os)/launcher.tsx",
    "app/(os)/_layout.tsx",
    "app/(os)/notifications.tsx",
    "app/(os)/developer/**/*.ts",
    "app/(os)/developer/**/*.tsx",
    "app/(os)/regulatory/**/*.ts",
    "app/(os)/regulatory/**/*.tsx",
    "app/_layout.tsx",
    "app/index.tsx",
    "app/+not-found.tsx",
    "app/auth/**/*.ts",
    "app/auth/**/*.tsx",
    "lib/admin/**/*.ts",
    "lib/admin/**/*.tsx",
    "lib/kernel/**/*.ts",
    "lib/kernel/**/*.tsx",
    "lib/shell/**/*.ts",
    "lib/shell/**/*.tsx",
    "lib/supabase/**/*.ts",
    "lib/auth/**/*.ts",
    "lib/auth/**/*.tsx",
    "lib/theme/**/*.ts",
    "lib/theme/**/*.tsx",
    "lib/toast/**/*.ts",
    "lib/toast/**/*.tsx",
    "lib/os/**/*.ts",
    "lib/os/**/*.tsx",
    "lib/providers/**/*.ts",
    "lib/providers/**/*.tsx",
    "lib/security/**/*.ts",
    "lib/security/**/*.tsx",
    "lib/compat/**/*.ts",
    "lib/compat/**/*.tsx",
    "lib/utils/**/*.ts",
    "lib/utils/**/*.tsx",
    "lib/modules/runtime/**/*.ts",
    "lib/modules/runtime/**/*.tsx",
    "lib/modules/wallet/**/*.ts",
    "lib/modules/wallet/**/*.tsx",
    "lib/mtaa/appstore/**/*.ts",
    "lib/mtaa/appstore/**/*.tsx",
    "lib/mtaa/kernel/**/*.ts",
    "lib/mtaa/kernel/**/*.tsx",
    "lib/mtaa/deeplinking/**/*.ts",
    "lib/mtaa/offline/**/*.ts",
    "hooks/useAdmin.ts",
    "hooks/useAuth.ts",
    "hooks/useIdentity.ts",
    "hooks/useAuthStore.ts",
    "types/**/*.ts",
    "constants/**/*.ts",
    "components/ui/**/*.ts",
    "components/ui/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "app/(boda)",
    "app/(business)",
    "app/(commerce)",
    "app/(communication)",
    "app/(local)",
    "app/(marketplace)",
    "app/(media)",
    "app/(mtaxi)",
    "app/(mtruck)",
    "app/(transport)",
    "app/(tribes)",
    "app/(jobs)",
    "app/(education)",
    "app/(health)",
    "app/(civic)",
    "app/(wallet)",
    "app/(settings)",
    "app/(auth)",
    "app/(os)/appstore",
    "app/(os)/phone",
    "app/(os)/settings",
    "app/(os)/wallet",
    "app/(os)/streets",
    "app/(os)/health",
    "app/(os)/civic",
