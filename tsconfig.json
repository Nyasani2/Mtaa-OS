    "app/(os)/documents",
    "app/(os)/gallery",
    "app/(os)/clock",
    "app/(os)/scheduler",
    "app/(os)/sim",
    "app/(os)/recents",
    "app/(os)/analytics",
    "app/(os)/ads",
    "app/(os)/binance",
    "app/(os)/courts",
    "app/(os)/credit",
    "apps",
    "asis",
    "components/appstore",
    "domains",
    "lib/mtaxi",
    "lib/mtruck",
    "lib/marketplace",
    "lib/ads",
    "lib/analytics",
    "lib/messages",
    "lib/streets",
    "lib/gallery",
    "lib/system",
