    "hooks/useAnalytics.ts",
    "hooks/useCivicAlerts.ts",
    "hooks/useCivic.ts",
    "hooks/useHealth.ts",
    "hooks/useInstalledApps.ts",
    "hooks/useKernelState.ts",
    "hooks/useMessages.ts",
    "hooks/useMessagingBus.ts",
    "hooks/useMTaxi.ts",
    "hooks/useMTruck.ts",
    "hooks/useNotifications.ts",
    "hooks/useRecentActivity.ts",
    "hooks/useScheduler.ts",
    "hooks/use-search.ts",
    "hooks/useSearch.ts",
