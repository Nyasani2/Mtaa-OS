{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "off",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/style-prop-object": "off",
    "react/no-unstable-nested-components": "off",
    "react/no-array-index-key": "off",
    "react/jsx-props-no-spread-multi": "off",
    "react/no-missing-button-type": "off",
    "react/no-missing-iframe-sandbox": "off",
    "react/no-namespace": "off",
    "react/no-redundant-should-component-update": "off",
    "react/no-typos": "off",
    "react/no-unused-class-component-methods": "off",
    "react/no-unused-state": "off",
    "react/self-closing-comp": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "off",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-non-null-assertion": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/prefer-optional-chain": "off",
    "typescript/consistent-type-imports": "off",
    "typescript/no-var-requires": "warn",
    "typescript/no-useless-empty-export": "off",
    "typescript/triple-slash-reference": "warn",
    "typescript/no-unnecessary-type-constraint": "off",
    "typescript/no-unsafe-function-type": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-import-type-side-effects": "off",
    "typescript/prefer-as-const": "off",
    "typescript/no-namespace": "off",
    "typescript/no-this-alias": "off",
    "typescript/no-unnecessary-condition": "off",
    "typescript/no-unnecessary-qualifier": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/prefer-function-type": "off",
    "typescript/prefer-literal-enum-member": "off",
    "typescript/prefer-readonly": "off",
    "typescript/switch-exhaustiveness-check": "off",
    "typescript/unbound-method": "off",
    "no-debugger": "error",
    "no-unreachable": "error",
    "no-const-assign": "error",
    "no-dupe-keys": "error",
    "no-dupe-class-members": "error",
    "no-duplicate-case": "error",
    "no-func-assign": "error",
    "no-import-assign": "error",
    "no-obj-calls": "error",
    "no-setter-return": "error",
    "no-this-before-super": "error",
    "valid-typeof": "error",
    "constructor-super": "error",
    "getter-return": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-control-regex": "error",
    "no-delete-var": "error",
    "no-empty-character-class": "error",
    "no-ex-assign": "error",
    "no-global-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unused-labels": "error",
    "no-with": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "no-eval": "off",
    "no-new-func": "error",
    "no-fallthrough": "error",
    "array-callback-return": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-empty-pattern": "error",
    "no-console": "off",
    "no-extra-boolean-cast": "off",
    "no-useless-catch": "off",
    "no-useless-escape": "off",
    "no-var": "off",
    "prefer-const": "off",
    "no-empty": "off",
    "dot-notation": "off",
    "no-alert": "off",
    "no-eq-null": "off",
    "no-shadow": "off",
    "no-unused-vars": "off",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-string-refs": "error",
    "react/no-unknown-property": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/require-render-return": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/void-dom-elements-no-children": "error",
    "typescript-eslint/no-var-requires": "off",
    "no-var-requires": "off",
    "oxc/double-comparisons": "off",
    "unicorn/no-unnecessary-await": "off",
    "no-constant-condition": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true,
    "jest": true
  },
  "globals": {
    "React": "readonly",
    "JSX": "readonly"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    ".expo/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "out/**",
    "ios/**",
    "android/**",
    "**/*.d.ts",
    "**/*.config.js",
    "**/*.config.ts",
    "**/*.config.mjs",
    "metro.config.js",
    "babel.config.js",
    "tailwind.config.js",
    "postcss.config.js",
    "next.config.js",
    "next.config.ts",
    "next.config.mjs",
    "app.json",
    "eas.json",
    "supabase/functions/_shared/**",
    "scripts/**",
    "**/__generated__/**"
  ]
}